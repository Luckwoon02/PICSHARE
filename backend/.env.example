# --- Security & Authentication ---
# The password for the /admin dashboard (username is always 'admin')
ADMIN_PASSWORD=admin123

# A long random string used to sign JWT tokens for security
SECRET_KEY=ThisIsMyLongSecretKeyForJWT

# --- AWS Credentials ---
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-1

# --- AWS S3 ---
S3_BUCKET_NAME=your-s3-bucket-name

# --- AWS Rekognition ---
# Match confidence threshold (0–100). 80 is a good default.
REKOGNITION_FACE_MATCH_THRESHOLD=80.0

# --- Database & Storage Paths (Relative to backend/ directory) ---
DB_PATH=data/app.db
